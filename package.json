    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jszip": "^3.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
